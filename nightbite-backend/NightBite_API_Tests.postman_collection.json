{
  "info": {
    "name": "NightBite API – Full Flow Tests",
    "description": "Test toàn bộ luồng: Auth → Shop → Product → Order → Trust Score → Notification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:8080/savibite" },
    { "key": "USER_TOKEN", "value": "" },
    { "key": "SHOP_TOKEN", "value": "" },
    { "key": "ADMIN_TOKEN", "value": "" },
    { "key": "USER_ID", "value": "" },
    { "key": "SHOP_ID", "value": "" },
    { "key": "PRODUCT_ID", "value": "" },
    { "key": "ORDER_ID", "value": "" },
    { "key": "ORDER_CODE", "value": "" }
  ],
  "item": [
    {
      "name": "1. AUTH",
      "item": [
        {
          "name": "1.1 Register User",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/auth/register/user",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Nguyễn Văn Test\",\n  \"email\": \"user_test@nightbite.vn\",\n  \"phone\": \"0901234567\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "1.2 Register Shop",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const d = pm.response.json().data; pm.collectionVariables.set('SHOP_TOKEN', d.accessToken); pm.collectionVariables.set('SHOP_ID', d.id);"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/auth/register/shop",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"shopName\": \"Tiệm Bánh Test\",\n  \"ownerName\": \"Chủ Shop Test\",\n  \"email\": \"shop_test@nightbite.vn\",\n  \"phone\": \"0907654321\",\n  \"password\": \"shoppass123\",\n  \"address\": \"123 Đường Nguyễn Trãi, Ninh Kiều, Cần Thơ\",\n  \"district\": \"Ninh Kiều\"\n}" }
          }
        },
        {
          "name": "1.3 Login User",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const d = pm.response.json().data;",
            "pm.collectionVariables.set('USER_TOKEN', d.accessToken);",
            "pm.collectionVariables.set('USER_ID', d.id);",
            "pm.test('Has accessToken', () => pm.expect(d.accessToken).to.be.a('string').and.not.empty);",
            "pm.test('Role is ROLE_USER', () => pm.expect(d.role).to.eql('ROLE_USER'));"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"user_test@nightbite.vn\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "1.4 Login Shop",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const d = pm.response.json().data;",
            "pm.collectionVariables.set('SHOP_TOKEN', d.accessToken);",
            "pm.collectionVariables.set('SHOP_ID', d.id);",
            "pm.test('Role is ROLE_SHOP', () => pm.expect(d.role).to.eql('ROLE_SHOP'));"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"shop_test@nightbite.vn\",\n  \"password\": \"shoppass123\"\n}" }
          }
        },
        {
          "name": "1.5 Login sai mật khẩu (expect 401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));",
            "pm.test('success = false', () => pm.expect(pm.response.json().success).to.be.false);"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"user_test@nightbite.vn\",\n  \"password\": \"WRONG_PASS\"\n}" }
          }
        },
        {
          "name": "1.6 GET /auth/me (User)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Role USER', () => pm.expect(pm.response.json().data.role).to.eql('ROLE_USER'));"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }]
          }
        },
        {
          "name": "1.7 GET /auth/me không có token (expect 401/403)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Không có token bị từ chối', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
          ]}}],
          "request": { "method": "GET", "url": "{{BASE_URL}}/auth/me" }
        }
      ]
    },
    {
      "name": "2. SHOP",
      "item": [
        {
          "name": "2.1 GET /shops (public)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('data is array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
          ]}}],
          "request": { "method": "GET", "url": "{{BASE_URL}}/shops" }
        },
        {
          "name": "2.2 GET /shops?district=Ninh Kiều",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": { "raw": "{{BASE_URL}}/shops?district=Ninh Kiều", "query": [{ "key": "district", "value": "Ninh Kiều" }] } }
        },
        {
          "name": "2.3 GET /shops/:id",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 hoặc 404', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));"
          ]}}],
          "request": { "method": "GET", "url": "{{BASE_URL}}/shops/{{SHOP_ID}}" }
        }
      ]
    },
    {
      "name": "3. PRODUCT (Flash Sale)",
      "item": [
        {
          "name": "3.1 POST /products (Shop tạo sản phẩm)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const d = pm.response.json().data;",
            "if(d && d.id) pm.collectionVariables.set('PRODUCT_ID', d.id);",
            "pm.test('Product có id', () => pm.expect(d.id).to.be.a('number'));"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/products",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{SHOP_TOKEN}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Bánh Mì Thịt Đặc Biệt\",\n  \"description\": \"Bánh mì giòn với thịt nguội và rau sống tươi\",\n  \"originalPrice\": 35000,\n  \"salePrice\": 18000,\n  \"quantityAvailable\": 20,\n  \"saleStartTime\": \"17:00:00\",\n  \"saleEndTime\": \"21:00:00\",\n  \"saleDate\": \"2026-06-25\",\n  \"allergenTags\": \"gluten,thịt lợn\",\n  \"category\": \"bánh mì\"\n}" }
          }
        },
        {
          "name": "3.2 GET /products (public – Flash Sale list)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('data is array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
          ]}}],
          "request": { "method": "GET", "url": "{{BASE_URL}}/products" }
        },
        {
          "name": "3.3 GET /products/:id",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 hoặc 404', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));"
          ]}}],
          "request": { "method": "GET", "url": "{{BASE_URL}}/products/{{PRODUCT_ID}}" }
        },
        {
          "name": "3.4 PUT /products/:id (Shop cập nhật)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "PUT",
            "url": "{{BASE_URL}}/products/{{PRODUCT_ID}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{SHOP_TOKEN}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"salePrice\": 15000,\n  \"quantityAvailable\": 15\n}" }
          }
        },
        {
          "name": "3.5 POST /products – User tạo sản phẩm (expect 403)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('User không tạo được product (403)', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/products",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Hack product\", \"originalPrice\": 1, \"salePrice\": 1, \"quantityAvailable\": 1 }" }
          }
        }
      ]
    },
    {
      "name": "4. ORDER",
      "item": [
        {
          "name": "4.1 POST /orders (User đặt hàng)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const d = pm.response.json().data;",
            "if(d && d.id) pm.collectionVariables.set('ORDER_ID', d.id);",
            "if(d && d.orderCode) pm.collectionVariables.set('ORDER_CODE', d.orderCode);",
            "pm.test('Có orderCode', () => pm.expect(d.orderCode).to.match(/^NB-/));",
            "pm.test('Status PENDING', () => pm.expect(d.status).to.eql('PENDING'));"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/orders",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"shopId\": {{SHOP_ID}},\n  \"items\": [\n    { \"productId\": {{PRODUCT_ID}}, \"quantity\": 2 }\n  ],\n  \"pickupTime\": \"2026-06-25T19:00:00\",\n  \"note\": \"Không hành\",\n  \"paymentMethod\": \"MOCK\"\n}" }
          }
        },
        {
          "name": "4.2 GET /orders (User xem lịch sử)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('data is array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }]
          }
        },
        {
          "name": "4.3 GET /orders/:id",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('orderCode match', () => pm.expect(pm.response.json().data.orderCode).to.eql(pm.collectionVariables.get('ORDER_CODE')));"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/orders/{{ORDER_ID}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }]
          }
        },
        {
          "name": "4.4 PATCH /orders/:id/status → CONFIRMED (Shop)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status CONFIRMED', () => pm.expect(pm.response.json().data.status).to.eql('CONFIRMED'));"
          ]}}],
          "request": {
            "method": "PATCH",
            "url": "{{BASE_URL}}/orders/{{ORDER_ID}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{SHOP_TOKEN}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"status\": \"CONFIRMED\" }" }
          }
        },
        {
          "name": "4.5 PATCH /orders/:id/status → DONE (Shop)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status DONE', () => pm.expect(pm.response.json().data.status).to.eql('DONE'));"
          ]}}],
          "request": {
            "method": "PATCH",
            "url": "{{BASE_URL}}/orders/{{ORDER_ID}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{SHOP_TOKEN}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"status\": \"DONE\" }" }
          }
        },
        {
          "name": "4.6 POST /orders – User tạo đơn 2 để test cancel",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const d = pm.response.json().data;",
            "pm.collectionVariables.set('ORDER_ID', d.id);"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/orders",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"shopId\": {{SHOP_ID}},\n  \"items\": [\n    { \"productId\": {{PRODUCT_ID}}, \"quantity\": 1 }\n  ],\n  \"paymentMethod\": \"MOCK\"\n}" }
          }
        },
        {
          "name": "4.7 PATCH /orders/:id/cancel (User huỷ – Trust Score giảm)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status CANCELLED', () => pm.expect(pm.response.json().data.status).to.eql('CANCELLED'));",
            "console.log('Trust score sau huỷ:', pm.response.json().data.trustScore);"
          ]}}],
          "request": {
            "method": "PATCH",
            "url": "{{BASE_URL}}/orders/{{ORDER_ID}}/cancel",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"cancelReason\": \"Tôi đổi ý\" }" }
          }
        }
      ]
    },
    {
      "name": "5. SECURITY CHECKS",
      "item": [
        {
          "name": "5.1 User cố PATCH status (expect 403)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('User không update status được (403)', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "PATCH",
            "url": "{{BASE_URL}}/orders/{{ORDER_ID}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"status\": \"DONE\" }" }
          }
        },
        {
          "name": "5.2 Shop cố vào /admin (expect 403)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Shop không vào Admin được (403)', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/admin/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{SHOP_TOKEN}}" }]
          }
        },
        {
          "name": "5.3 Token giả mạo (expect 401/403)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Token giả bị từ chối', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer fake.token.here" }]
          }
        },
        {
          "name": "5.4 Swagger UI accessible (no token)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Swagger UI 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": "http://localhost:8080/swagger-ui/index.html" }
        }
      ]
    },
    {
      "name": "6. NOTIFICATION",
      "item": [
        {
          "name": "6.1 GET /notifications (User)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('data is array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/notifications",
            "header": [{ "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }]
          }
        },
        {
          "name": "6.2 GET /notifications/unread-count",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Có unreadCount', () => pm.expect(pm.response.json().data).to.have.property('unreadCount'));"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/notifications/unread-count",
            "header": [{ "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }]
          }
        },
        {
          "name": "6.3 PATCH /notifications/read-all",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "PATCH",
            "url": "{{BASE_URL}}/notifications/read-all",
            "header": [{ "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }]
          }
        }
      ]
    },
    {
      "name": "7. VALIDATION ERRORS",
      "item": [
        {
          "name": "7.1 Register User thiếu email (expect 400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));",
            "pm.test('success = false', () => pm.expect(pm.response.json().success).to.be.false);"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/auth/register/user",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"fullName\": \"Thiếu email\", \"password\": \"123456\" }" }
          }
        },
        {
          "name": "7.2 Register User email đã tồn tại (expect 409)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/auth/register/user",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"fullName\": \"Trùng email\", \"email\": \"user_test@nightbite.vn\", \"password\": \"password123\" }" }
          }
        }
      ]
    }
  ]
}
